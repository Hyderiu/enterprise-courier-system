# 企业快递系统公开演示配置
# 复制为 .env 后使用。任何真实密钥都只能写进 .env，严禁提交到 Git。

APP_HOST=127.0.0.1
APP_PORT=26666
DEBUG=false
DATABASE_URL=sqlite:///./demo.db

# 公开演示：关闭钉钉登录，使用脱敏演示管理员。
DINGTALK_LOGIN_ENABLED=false
LOCAL_USER_ID=1
PREVIEW_SAFE_MODE=true
SCHEDULER_ENABLED=true
PUBLIC_BASE_URL=http://127.0.0.1:26666
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=43200

# CRM（按实际供应商文档填写；公开版不包含内部地址或凭证）
CRM_BASE_URL=https://crm-api.example.com/api
CRM_APP_ID=
CRM_APP_SECRET=
CRM_REQUEST_TIMEOUT=30
CRM_REQUEST_RETRIES=2
CRM_PAGE_SIZE=200

# 文件和上传限制
BILLING_ALLOCATION_DIR=.runtime/billing-allocations
MAX_UPLOAD_BYTES=5242880

# 顺丰丰桥
SF_API_URL=https://sfapi-sbox.sf-express.com/std/service
SF_CUSTOMER_CODE=
SF_CHECK_WORD=
SF_MONTHLY_CARD=
SF_MOCK_MODE=true
SF_LIVE_ORDER_ENABLED=false
SF_API_TIMEOUT=20

# 顺丰同城
SF_CITY_API_URL=https://openic.sf-express.com
SF_CITY_FEATURE_ENABLED=false
SF_CITY_DEV_ID=
SF_CITY_DEV_KEY=
SF_CITY_SHOP_ID=
SF_CITY_LIVE_ORDER_ENABLED=false
SF_CITY_CALLBACK_TOKEN=
SF_CITY_RIDER_WAIT_MINUTES=30

# 德邦
DB_COMPANY_CODE=
DB_CUSTOMER_CODE=
DB_APPKEY=
DB_SIGN=
DB_MOCK_MODE=true
DB_LIVE_ORDER_ENABLED=false
DB_API_TIMEOUT=20

# 京东物流
JDL_API_URL=https://api.jdl.com
JDL_APP_KEY=
JDL_APP_SECRET=
JDL_ACCESS_TOKEN=
JDL_CUSTOMER_CODE=
JDL_BUSINESS_UNIT_CODE=
JDL_API_TIMEOUT=20
JDL_LIVE_ORDER_ENABLED=false

# 钉钉（正式部署时由企业内部应用提供）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_CORP_ID=
DINGTALK_OA_PROCESS_CODE=
DINGTALK_EVENT_TOKEN=
DINGTALK_EVENT_AES_KEY=

# 报价性能参数
COURIER_QUOTE_TIMEOUT=5
COURIER_QUOTE_TOTAL_TIMEOUT=10
COURIER_QUOTE_CACHE_SECONDS=300
